# required
GITHUB_WEBHOOK_SECRET=           # random string, must match the secret in GitHub webhook settings
ANTHROPIC_API_KEY=               # console.anthropic.com > Settings > API keys
DISCORD_WEBHOOK_URL=             # Discord: Channel > Edit Channel > Integrations > Webhooks

# required for private repos (fine-grained PAT, Contents: Read-only)
GITHUB_TOKEN=

# optional tuning
MODEL=claude-haiku-5-5           # $0.10/$0.50 per MTok (prompts under 100k tokens)
EFFORT=low                       # low | medium | high. how much Haiku thinks; billed at output rates
MAX_COMMITS_PER_PUSH=5           # newest N get full explanations, rest get a rollup line
MAX_DIFF_CHARS=12000             # hard cap on diff sent to the LLM (~3k tokens)
MAX_TOKENS=1200                  # includes thinking tokens, do not set this near 400
BRANCH_FILTER=                   # e.g. main,develop. empty = all branches
SKIP_MERGE_COMMITS=true
